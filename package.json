{
  "name": "gmt-typescript-sdk",
  "version": "0.37.2",
  "description": "The official TypeScript library for the Gmt API",
  "author": "Gmt <contact@example.com>",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "type": "commonjs",
  "repository": "github:cameo6/gmt-typescript-sdk",
  "license": "Apache-2.0",
  "files": [
    "**/*"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "20.19.25",
    "typescript": "5.8.3"
  },
  "overrides": {
    "minimatch": "^9.0.5"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^9.0.5"
    }
  },
  "resolutions": {
    "minimatch": "^9.0.5"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*.mjs": {
      "default": "./dist/*.mjs"
    },
    "./*.js": {
      "default": "./dist/*.js"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "sh scripts/build",
    "prepare": "test -f dist/index.mjs || npm run build"
  }
}
